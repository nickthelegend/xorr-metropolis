# The chain and contracts to index. For the local fork, from server/.env.fork after `npm run rebuild:fork`.
ENVIO_CHAIN_ID=143
ENVIO_RPC_URL=http://127.0.0.1:8561
ENVIO_START_BLOCK=110838470
ENVIO_DELEGATION=0xcc143160a58e6b8683fca4751bd556acf4466094
ENVIO_ANCHOR=0x3f121b6636ac59a9c1bceefb73bb0f3c9390e8d5
# Perpl's DelegatedAccount factory: mainnet (and its fork) 0xc535…907a; testnet 0xf425…7209.
ENVIO_PERPL_FACTORY=0xc535276e3e446e4f28d95ed27ccd5c32e4c8907a
# Names for the venues a fill can go through (lowercase addresses).
ENVIO_KURU_VENUE=0xfe77096238cd2974dd6ee7ddf38b21d97297164e
ENVIO_UNISWAP_ROUTER=0xfe31f71c1b106eac32f1a19239c9a9a72ddfb900

# Self-hosted: the executor's own Postgres, in a schema of its own, no Hasura (the executor is the API).
ENVIO_PG_HOST=localhost
ENVIO_PG_PORT=5432
ENVIO_PG_USER=${USER}
ENVIO_PG_PASSWORD=
ENVIO_PG_DATABASE=xorr_metropolis
ENVIO_PG_SCHEMA=envio
ENVIO_HASURA=false
ENVIO_TUI=false
ENVIO_INDEXER_PORT=9899
